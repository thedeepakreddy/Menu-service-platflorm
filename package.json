{
  "name": "menu-service-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run build --filter=./packages/* && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "pnpm --filter @platform/tests run arch",
    "test:e2e": "pnpm --filter @platform/tests run e2e"
  },
  "devDependencies": {
    "@platform/config": "workspace:*",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  }
}
