# Web runtime configuration. Copy to .env.local for local use; never commit it.
# Validated by next.config.ts: `next build` and `next start` refuse to run if invalid.

# One of: development | test | staging | production
APP_ENV=development

# --- Web login (Phase 2 M2.6; D-030, D-033) — optional per trust domain ---
# A domain left unset: its /auth/<kind>/* routes answer 404 (fail closed). Any domain set requires
# WEB_PUBLIC_ORIGIN and WEB_SESSION_SECRET. Issuers must be https (there is no plain-http path).
# Exact public origin; every redirect URI is built from it, never from request headers.
# WEB_PUBLIC_ORIGIN=https://app.example
# SECRET: >= 32 random bytes, base64url (session encryption key). Rotating it ends every session.
# WEB_SESSION_SECRET=CHANGE_ME
# Owners (ZITADEL owners project web client, D-032). Extra scopes are configuration, e.g.
# urn:zitadel:iam:org:project:id:<projectId>:aud
# WEB_OWNER_OIDC_ISSUER=https://<instance>.zitadel.cloud
# WEB_OWNER_OIDC_CLIENT_ID=
# WEB_OWNER_OIDC_CLIENT_SECRET=CHANGE_ME
# WEB_OWNER_OIDC_SCOPES=
# Operators (operators org with Force MFA; separate project and client).
# WEB_OPERATOR_OIDC_ISSUER=https://<instance>.zitadel.cloud
# WEB_OPERATOR_OIDC_CLIENT_ID=
# WEB_OPERATOR_OIDC_CLIENT_SECRET=CHANGE_ME
# WEB_OPERATOR_OIDC_SCOPES=
