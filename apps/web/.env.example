# Web runtime configuration. Copy to .env.local for local use; never commit it.
# Validated by next.config.ts: `next build` and `next start` refuse to run if invalid.

# One of: development | test | staging | production
APP_ENV=development

# --- Web login (Phase 2 M2.6 + remediation; D-030, D-034, D-038) — optional per trust domain ---
# A domain left unset: its /auth/<kind>/* routes answer 404 (fail closed). Any domain set requires
# WEB_PUBLIC_ORIGIN, WEB_SESSION_SECRET, WEB_API_ORIGIN and WEB_API_BFF_CREDENTIAL. Issuers must be
# https (there is no plain-http path). Sessions live server-side at the API (PostgreSQL); the
# browser cookie holds only an opaque token.
# Exact public origin; every redirect URI is built from it, never from request headers.
# WEB_PUBLIC_ORIGIN=https://app.example
# SECRET: exactly 32 random bytes, base64url without padding (43 characters). Seals only the
# 10-minute login-transaction cookie. e.g. `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
# WEB_SESSION_SECRET=CHANGE_ME
# The API's origin for server-to-server session calls (https in staging/production).
# WEB_API_ORIGIN=https://api.internal.example
# SECRET: must equal the API's API_BFF_CREDENTIAL (43-128 base64url characters).
# WEB_API_BFF_CREDENTIAL=CHANGE_ME
# Optional (D-038): trusted reverse proxies in front of the web app that append X-Forwarded-For
# (0-5, default 0 = none: per-client login limits fall back to the global limits).
# WEB_TRUSTED_PROXY_HOPS=0
# Optional (C-03): global cap on token requests to the identity provider per instance and minute.
# WEB_TOKEN_REQUESTS_PER_MINUTE=600
# Owners (ZITADEL owners project web client, D-032). Extra scopes are configuration, e.g.
# urn:zitadel:iam:org:project:id:<projectId>:aud
# WEB_OWNER_OIDC_ISSUER=https://<instance>.zitadel.cloud
# WEB_OWNER_OIDC_CLIENT_ID=
# WEB_OWNER_OIDC_CLIENT_SECRET=CHANGE_ME
# WEB_OWNER_OIDC_SCOPES=
# Operators (operators org with Force MFA; separate project and client).
# WEB_OPERATOR_OIDC_ISSUER=https://<instance>.zitadel.cloud
# WEB_OPERATOR_OIDC_CLIENT_ID=
# WEB_OPERATOR_OIDC_CLIENT_SECRET=CHANGE_ME
# WEB_OPERATOR_OIDC_SCOPES=
