# API runtime configuration. Copy to .env for local use; never commit .env.
# Required variables have no defaults; the API refuses to start if any is missing or invalid.

# Required. One of: development | test | staging | production
APP_ENV=development
# Required. Interface to bind. Use 127.0.0.1 locally; 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
# Required. TCP port, 1-65535
API_PORT=4000
# Required (D-028, D-029). SECRET: the restricted runtime role's connection string. Never commit a
# real value. The API refuses to start unless this role holds exactly the runtime privileges
# (no membership, ownership, superuser, BYPASSRLS or preset settings; D-035).
# staging/production must require TLS (sslmode=require, verify-ca or verify-full).
API_DATABASE_URL=postgres://app_runtime:CHANGE_ME@127.0.0.1:5432/platform_dev
# Optional in development/test, REQUIRED in staging/production (D-028). SECRET: the app_operator
# role, the only path to the audited operator functions. Unset: operator actions answer 503.
# API_OPERATOR_DATABASE_URL=postgres://app_operator:CHANGE_ME@127.0.0.1:5432/platform_dev
# Optional. Maximum pooled connections, 1-100. Defaults to 10.
API_DATABASE_POOL_MAX=10

# Optional (D-019). Comma-separated exact origins allowed for CORS, e.g.
#   https://owner.example.com,https://www.example.com
# Absent or empty = no cross-origin access. Wildcards, "null" and paths are rejected;
# staging and production require https:// origins.
API_CORS_ALLOWED_ORIGINS=
# Optional (D-020). One of: error | warn | info | debug. Defaults to info.
# debug is rejected in staging and production.
API_LOG_LEVEL=info

# Optional in development/test, REQUIRED in staging/production (D-025, D-034). Two separate OIDC
# trust domains; all four variables of a domain together. A domain left unset cannot log in.
# AUDIENCE = the API audience in the access token's aud (ZITADEL: the project id);
# CLIENT_ID = the web BFF client (the ID token's aud/azp and the access token's client_id).
# Access tokens must be JWTs (ZITADEL app setting "Auth Token Type = JWT").
# API_OWNER_OIDC_ISSUER=https://owners.idp.example
# API_OWNER_OIDC_AUDIENCE=owner-project-id
# API_OWNER_OIDC_JWKS_URL=https://owners.idp.example/oauth/v2/keys
# API_OWNER_OIDC_CLIENT_ID=owner-web-client-id
# API_OPERATOR_OIDC_ISSUER=https://operators.idp.example
# API_OPERATOR_OIDC_AUDIENCE=operator-project-id
# API_OPERATOR_OIDC_JWKS_URL=https://operators.idp.example/oauth/v2/keys
# API_OPERATOR_OIDC_CLIENT_ID=operator-web-client-id

# Required whenever a login domain is set (D-034). SECRET: the credential the web BFF presents on
# every authenticated call; 43-128 base64url characters (e.g. `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`).
# Must equal WEB_API_BFF_CREDENTIAL. Never commit a real value.
# API_BFF_CREDENTIAL=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE

# Optional (D-034). Operator sessions end this long after the MFA login (60-3600, default 3600).
# API_OPERATOR_MFA_MAX_AGE_SECONDS=3600
# Optional (D-034). Idle timeouts, renewed on use: owners 60-28800 (default 1800), operators 60-3600 (default 900).
# API_OWNER_SESSION_IDLE_SECONDS=1800
# API_OPERATOR_SESSION_IDLE_SECONDS=900

# Optional (D-037). Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For entries are
# trusted for rate limiting. Default: none (X-Forwarded-For is ignored).
# API_TRUSTED_PROXIES=10.0.0.0/8
