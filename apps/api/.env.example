# API runtime configuration. Copy to .env for local use; never commit .env.
# All variables are required; the API refuses to start if any is missing or invalid.

# One of: development | test | staging | production
APP_ENV=development
# Interface to bind. Use 127.0.0.1 locally; 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
# TCP port, 1-65535
API_PORT=4000
